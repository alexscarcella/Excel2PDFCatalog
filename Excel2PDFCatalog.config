[Excel]
# mapping between the app fields and the column headers of your .xlsx
XLS_COLUMN_CATEGORY = Cat_Merc
XLS_COLUMN_COMPANY = Azienda
XLS_COLUMN_ITEM = Nome_Art
XLS_COLUMN_SIZE = Formato
XLS_COLUMN_PRICE = prezzo_vendita_ingrosso
XLS_COLUMN_DESCRIPTION = Descrizione_prodotto
XLS_COLUMN_IMG = Codice_Articolo
XLS_BADGE = Badge

[Layout]
# MARGIN: A4 sheet margin, in cm
# CARD_BORDER_WIDTH: product-card border thickness, in points
MARGIN = 2
CARD_BORDER_WIDTH = 2

[System]
# LOCALE: platform-specific locale string used by build_PDF.py
LOCALE = it_IT.UTF-8
